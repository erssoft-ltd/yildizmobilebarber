---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yildiz Mobile Barber",
  description =
    "Professional mobile barber services delivered directly to your home.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen bg-brand-dark font-body text-brand-text antialiased">
    <Header />

    <slot />

    <Footer />
    <WhatsAppButton />
  </body>

</html>