---
const whatsappMessage =
  "Hello Emre, I would like to book a mobile barber appointment.";

const whatsappLink =
  `https://wa.me/447877739107?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
  href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Book on WhatsApp"
  class="group fixed bottom-6 right-6 z-50"
>
  <div
    class="flex items-center gap-3 rounded-full bg-[#25D366] px-5 py-3 shadow-2xl transition-all duration-300 hover:scale-105 hover:shadow-green-500/40"
  >
    <img
      src="/icons/whatsapp-icon.svg"
      alt="WhatsApp"
      class="h-8 w-8"
    />

    <span
      class="hidden whitespace-nowrap text-sm font-semibold text-white lg:block"
    >
      Book on WhatsApp
    </span>
  </div>
</a>