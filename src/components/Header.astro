---
const navigation = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { href: "#why-us", label: "Why Choose Us" },
  { label: "Gallery", href: "#gallery" },
  { label: "Contact", href: "#contact" },
];

const whatsappLink =
  "https://wa.me/447877739107?text=Hello%20Emre,%20I%20would%20like%20to%20book%20a%20mobile%20barber%20appointment.";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand-dark/95 backdrop-blur"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6"
  >
    <!-- Logo -->
    <a
        href="#home"
        class="font-display text-3xl font-bold tracking-tight text-brand-text"
    >
        Yildiz <span class="text-brand-gold"> Mobile Barber</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-10 lg:flex">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-brand-text transition hover:text-brand-gold"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full bg-brand-gold px-6 py-3 text-sm font-semibold text-brand-dark transition hover:bg-brand-gold-light lg:inline-flex"
    >
      Book Now
    </a>

    <!-- Mobile Menu Button -->
    <button
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-brand-text lg:hidden"
      aria-label="Open menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>
  </div>
</header>