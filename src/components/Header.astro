---
const navigation = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Why Choose Us", href: "#why-us" },
  { label: "Gallery", href: "#gallery" },
  { label: "Contact", href: "#contact" },
];

const whatsappLink =
  "https://wa.me/447877739107?text=Hello%20Emre%2C%20I%20would%20like%20to%20book%20a%20mobile%20barber%20appointment.";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand-dark/95 backdrop-blur"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
    <!-- Logo -->
    <a
      href="#home"
      class="font-display text-2xl font-bold tracking-tight text-brand-text sm:text-3xl"
    >
      Yildiz <span class="text-brand-gold">Mobile Barber</span>
    </a>

    <!-- Desktop navigation -->
    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label="Main navigation"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-brand-text transition hover:text-brand-gold"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop WhatsApp button -->
    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full bg-brand-gold px-6 py-3 text-sm font-semibold text-brand-dark transition hover:bg-brand-gold-light lg:inline-flex"
    >
      Book Now
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/30 text-brand-text transition hover:border-brand-gold hover:text-brand-gold lg:hidden"
      aria-label="Open mobile menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <!-- Hamburger icon -->
      <svg
        id="menu-open-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>

      <!-- Close icon -->
      <svg
        id="menu-close-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="hidden h-7 w-7"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-brand-dark lg:hidden"
  >
    <nav
      class="mx-auto flex max-w-7xl flex-col px-6 py-5"
      aria-label="Mobile navigation"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="mobile-menu-link border-b border-white/10 py-4 text-lg font-medium text-brand-text transition hover:text-brand-gold"
          >
            {item.label}
          </a>
        ))
      }

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex justify-center rounded-full bg-brand-gold px-6 py-3.5 font-semibold text-brand-dark transition hover:bg-brand-gold-light"
      >
        Book on WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector("#mobile-menu-button");
  const mobileMenu = document.querySelector("#mobile-menu");
  const openIcon = document.querySelector("#menu-open-icon");
  const closeIcon = document.querySelector("#menu-close-icon");
  const mobileLinks = document.querySelectorAll(".mobile-menu-link");

  function closeMobileMenu() {
    mobileMenu?.classList.add("hidden");
    openIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Open mobile menu");
  }

  menuButton?.addEventListener("click", () => {
    const isClosed = mobileMenu?.classList.contains("hidden");

    mobileMenu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");

    menuButton.setAttribute("aria-expanded", String(isClosed));
    menuButton.setAttribute(
      "aria-label",
      isClosed ? "Close mobile menu" : "Open mobile menu"
    );
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });
</script>