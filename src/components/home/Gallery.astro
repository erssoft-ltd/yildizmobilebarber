---
const galleryImages = [
  {
    src: "/images/gallery-cut-01.jpg",
    alt: "Yildiz Mobile Barber providing a professional haircut",
  },
  {
    src: "/images/gallery-treatment-01.jpg",
    alt: "Traditional barber treatment by Yildiz Mobile Barber",
  },
  {
    src: "/images/mobile-barber-treatment-01.jpg",
    alt: "Mobile barber grooming treatment at the customer's location",
  },
  {
    src: "/images/about-emre-yildiz.jpg",
    alt: "Emre Yildiz providing a mobile barber service",
  },
  {
    src: "/images/hero-mobile-barber.jpg",
    alt: "Mobile haircut service at a customer's home",
  },
];
---

<section
  id="gallery"
  class="relative overflow-hidden bg-brand-dark py-24 sm:py-28"
>
  <div
    aria-hidden="true"
    class="absolute -right-40 top-1/4 h-96 w-96 rounded-full bg-brand-gold/10 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-gold">
          Gallery
        </p>

        <h2 class="mt-4 font-display text-4xl font-bold text-brand-text sm:text-5xl">
          Real appointments. Real mobile barber service.
        </h2>

        <p class="mt-6 text-lg leading-8 text-brand-muted">
          A selection of genuine work completed at customers' homes and other
          convenient locations.
        </p>
      </div>

      <a
        href="#contact"
        class="inline-flex w-fit rounded-full border border-brand-gold px-6 py-3 font-semibold text-brand-gold transition hover:bg-brand-gold hover:text-brand-dark"
      >
        Book Your Appointment
      </a>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
      {
        galleryImages.map((image, index) => (
          <figure
            class:list={[
              "group relative overflow-hidden rounded-3xl border border-white/10 bg-brand-surface",
              index === 0
                ? "sm:col-span-2 lg:col-span-7 lg:row-span-2"
                : index === 1
                  ? "lg:col-span-5"
                  : "lg:col-span-4",
            ]}
          >
            <img
              src={image.src}
              alt={image.alt}
              width="1200"
              height="900"
              loading="lazy"
              class:list={[
                "h-full w-full object-cover transition duration-500 group-hover:scale-105",
                index === 0 ? "min-h-[520px]" : "min-h-[300px]",
              ]}
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-70"></div>

            <figcaption class="absolute inset-x-0 bottom-0 p-5">
              <p class="font-semibold text-white">
                Professional mobile barber service
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>