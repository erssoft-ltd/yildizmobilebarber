---
const phoneDisplay = "07877 739107";
const phoneLink = "tel:+447877739107";
const email = "emreyildiz4849@gmail.com";

const whatsappMessage =
  "Hello Emre, I would like to book a mobile barber appointment.";

const whatsappLink =
  `https://wa.me/447877739107?text=${encodeURIComponent(whatsappMessage)}`;

/*
  Daha sonra aşağıdaki iki adresi gerçek bağlantılarla değiştireceğiz.
*/
const instagramLink = "https://www.instagram.com/yildiz_mobile_barber/";
const facebookLink = "https://www.facebook.com/profile.php?id=100068523071255";
---

<section
  id="contact"
  class="relative overflow-hidden bg-brand-surface py-24 sm:py-28"
>
  <div
    aria-hidden="true"
    class="absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-brand-gold/10 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div
      class="overflow-hidden rounded-[2rem] border border-white/10 bg-brand-dark shadow-2xl shadow-black/30"
    >
      <div class="grid lg:grid-cols-2">
        <!-- Contact content -->
        <div class="p-8 sm:p-12 lg:p-16">
          <p
            class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-gold"
          >
            Contact & Booking
          </p>

          <h2
            class="mt-4 font-display text-4xl font-bold leading-tight text-brand-text sm:text-5xl"
          >
            Ready for your next haircut?
          </h2>

          <p class="mt-6 max-w-xl text-lg leading-8 text-brand-muted">
            Contact Emre directly to arrange a mobile barber appointment at
            your home, workplace or event.
          </p>

          <div class="mt-10 space-y-5">
            <!-- Phone -->
            <a
              href={phoneLink}
              class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-brand-surface p-5 transition hover:border-brand-gold/50"
            >
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xl text-brand-dark"
                aria-hidden="true"
              >
                ☎
              </span>

              <span>
                <span
                  class="block text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted"
                >
                  Call
                </span>

                <span
                  class="mt-1 block text-lg font-semibold text-brand-text transition group-hover:text-brand-gold"
                >
                  {phoneDisplay}
                </span>
              </span>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${email}`}
              class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-brand-surface p-5 transition hover:border-brand-gold/50"
            >
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xl text-brand-dark"
                aria-hidden="true"
              >
                ✉
              </span>

              <span class="min-w-0">
                <span
                  class="block text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted"
                >
                  Email
                </span>

                <span
                  class="mt-1 block break-all text-base font-semibold text-brand-text transition group-hover:text-brand-gold sm:text-lg"
                >
                  {email}
                </span>
              </span>
            </a>
          </div>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-brand-gold px-7 py-3.5 font-semibold text-brand-dark transition hover:-translate-y-0.5 hover:bg-brand-gold-light"
            >
              Book on WhatsApp
            </a>

            <a
              href={phoneLink}
              class="inline-flex items-center justify-center rounded-full border border-white/20 px-7 py-3.5 font-semibold text-brand-text transition hover:border-brand-gold hover:text-brand-gold"
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Service information -->
        <div
          class="border-t border-white/10 bg-brand-gold/10 p-8 sm:p-12 lg:border-l lg:border-t-0 lg:p-16"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-gold"
          >
            Mobile Service
          </p>

          <h3
            class="mt-4 font-display text-3xl font-bold leading-tight text-brand-text"
          >
            Professional grooming at your chosen location.
          </h3>

          <ul class="mt-8 space-y-5 text-brand-muted">
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xs font-bold text-brand-dark"
              >
                ✓
              </span>

              <span>Appointments at your home</span>
            </li>

            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xs font-bold text-brand-dark"
              >
                ✓
              </span>

              <span>Workplace barber visits</span>
            </li>

            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xs font-bold text-brand-dark"
              >
                ✓
              </span>

              <span>Private events and special occasions</span>
            </li>

            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-gold text-xs font-bold text-brand-dark"
              >
                ✓
              </span>

              <span>Professional and hygienic equipment</span>
            </li>
          </ul>

          <div class="mt-10 border-t border-white/10 pt-8">
            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-muted"
            >
              Follow Yildiz Mobile Barber
            </p>

            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href={instagramLink}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-brand-text transition hover:border-brand-gold hover:text-brand-gold"
              >
                Instagram
              </a>

              <a
                href={facebookLink}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-brand-text transition hover:border-brand-gold hover:text-brand-gold"
              >
                Facebook
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>