---
const whatsappBase =
  "https://wa.me/447877739107?text=";

const services = [
  {
    name: "Dry Cut",
    description: "A clean, professional haircut at your location.",
    price: "£17",
  },
  {
    name: "Dry Cut & Wash",
    description: "Haircut with a wash for a fresh, complete finish.",
    price: "£20",
  },
  {
    name: "All Over Clipper Cut",
    description: "Clipper cut using grades 1, 2, 3 or 4.",
    price: "£15",
    note: "Monday to Friday",
  },
  {
    name: "Skin Fade & Zero",
    description: "A sharp fade with a clean and modern finish.",
    price: "£19",
  },
  {
    name: "Hot Towel & Shave",
    description: "Traditional hot towel preparation and professional shave.",
    price: "£16",
  },
  {
    name: "Beard Trim, Shape-Up & Hot Towel",
    description: "Beard shaping and trimming with a traditional hot towel.",
    price: "£16",
  },
  {
    name: "Children's Cut",
    description: "Professional haircut for children under 12.",
    price: "£14",
    note: "Monday to Friday",
  },
  {
    name: "OAP Cut",
    description: "A comfortable and professional haircut service.",
    price: "£14",
    note: "Monday to Friday",
  },
  {
    name: "Face Mask",
    description: "Refreshing facial treatment as part of your grooming service.",
    price: "£8",
  },
  {
    name: "Nose Wax",
    description: "Quick and professional nose waxing treatment.",
    price: "£7",
  },
  {
    name: "Full Service",
    description: "Haircut, hot towel shave and relaxing massage.",
    price: "£32",
    featured: true,
  },
  {
    name: "Skin Fade, Shave & Hot Towel",
    description: "Complete skin fade, shave and traditional hot towel service.",
    price: "£34",
    featured: true,
  },
];

const createBookingLink = (serviceName: string) => {
  const message =
    `Hello Emre, I would like to book the ${serviceName} service.`;

  return `${whatsappBase}${encodeURIComponent(message)}`;
};
---

<section
  id="services"
  class="relative overflow-hidden bg-brand-dark py-24 sm:py-28"
>
  <div
    aria-hidden="true"
    class="absolute -left-40 top-1/3 h-96 w-96 rounded-full bg-brand-gold/10 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-gold"
      >
        Services & Prices
      </p>

      <h2
        class="mt-4 font-display text-4xl font-bold leading-tight text-brand-text sm:text-5xl"
      >
        Professional grooming at your location.
      </h2>

      <p class="mt-6 text-lg leading-8 text-brand-muted">
        Choose the service you need and book directly through WhatsApp.
        Yildiz Mobile Barber comes to your home, workplace or event.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        services.map((service) => (
          <article
            class:list={[
              "group relative flex h-full flex-col rounded-3xl border p-6 transition duration-300 hover:-translate-y-1",
              service.featured
                ? "border-brand-gold bg-brand-gold/10 shadow-lg shadow-brand-gold/5"
                : "border-white/10 bg-brand-surface hover:border-brand-gold/40",
            ]}
          >
            {service.featured && (
              <span
                class="absolute right-5 top-5 rounded-full bg-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-dark"
              >
                Popular
              </span>
            )}

            <div class="pr-20">
              <h3 class="font-display text-2xl font-bold text-brand-text">
                {service.name}
              </h3>

              <p class="mt-3 leading-7 text-brand-muted">
                {service.description}
              </p>
            </div>

            {service.note && (
              <p
                class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-brand-gold"
              >
                {service.note}
              </p>
            )}

            <div
              class="mt-auto flex items-end justify-between gap-4 border-t border-white/10 pt-6"
            >
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-brand-muted">
                  From
                </p>

                <p class="mt-1 text-3xl font-bold text-brand-gold">
                  {service.price}
                </p>
              </div>

              <a
                href={createBookingLink(service.name)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Book ${service.name} on WhatsApp`}
                class="inline-flex rounded-full border border-brand-gold px-5 py-2.5 text-sm font-semibold text-brand-gold transition hover:bg-brand-gold hover:text-brand-dark"
              >
                Book Now
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div
      class="mt-12 rounded-3xl border border-brand-gold/30 bg-brand-surface px-6 py-8 text-center sm:px-10"
    >
      <p class="font-display text-2xl font-bold text-brand-text">
        Need help choosing a service?
      </p>

      <p class="mx-auto mt-3 max-w-2xl leading-7 text-brand-muted">
        Contact Emre directly to discuss the haircut or grooming service you
        need and arrange a convenient appointment.
      </p>

      <div
        class="mt-6 flex flex-col justify-center gap-4 sm:flex-row"
      >
        <a
          href="https://wa.me/447877739107?text=Hello%20Emre%2C%20I%20would%20like%20some%20information%20about%20your%20mobile%20barber%20services."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center rounded-full bg-brand-gold px-7 py-3.5 font-semibold text-brand-dark transition hover:bg-brand-gold-light"
        >
          Message on WhatsApp
        </a>

        <a
          href="tel:+447877739107"
          class="inline-flex justify-center rounded-full border border-white/20 px-7 py-3.5 font-semibold text-brand-text transition hover:border-brand-gold hover:text-brand-gold"
        >
          Call 07877 739107
        </a>
      </div>
    </div>
  </div>
</section>